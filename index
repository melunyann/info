<script>
(function(){
var wrap=document.getElementById('nav-wrap'),btn=document.getElementById('nav-btn'),panel=document.getElementById('nav-panel'),overlay=document.getElementById('nav-overlay');
function openMenu(){wrap.classList.add('open');panel.classList.add('show');overlay.classList.add('show');}
function closeMenu(){wrap.classList.remove('open');panel.classList.remove('show');overlay.classList.remove('show');}
btn.addEventListener('click',function(){panel.classList.contains('show')?closeMenu():openMenu();});
overlay.addEventListener('click',closeMenu);
panel.querySelectorAll('.nav-item').forEach(function(item){
item.addEventListener('click',function(e){
e.preventDefault();
var t=document.querySelector(this.getAttribute('href'));
closeMenu();
if(t) t.scrollIntoView({behavior:'smooth',block:'start'});
});
});

document.querySelectorAll('.avatar img, .orderimg img').forEach(function(img){
img.addEventListener('contextmenu',function(e){e.preventDefault();});
img.addEventListener('dragstart',function(e){e.preventDefault();});
});

function loadToCanvas(item,wm){
var src=item.getAttribute('data-src');if(!src)return;
var canvas=item.querySelector('canvas');if(!canvas)return;
var image=new Image();image.crossOrigin='anonymous';
image.onload=function(){
var w=item.offsetWidth||140,h=item.offsetHeight||w;
var dpr=Math.max(Math.min(window.devicePixelRatio||1,3),2);
canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);
var ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);ctx.imageSmoothingQuality='high';
var ir=image.naturalWidth/image.naturalHeight,cr=w/h,sx,sy,sw,sh;
if(ir>cr){sh=image.naturalHeight;sw=sh*cr;sx=(image.naturalWidth-sw)/2;sy=0;}
else{sw=image.naturalWidth;sh=sw/cr;sx=0;sy=(image.naturalHeight-sh)/2;}
ctx.drawImage(image,sx,sy,sw,sh,0,0,w,h);
ctx.save();ctx.globalAlpha=0.1;ctx.fillStyle='#3F3A42';
ctx.font='bold '+Math.round(w*0.12)+'px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
ctx.translate(w/2,h/2);ctx.rotate(-Math.PI/4);
var step=Math.round(Math.max(w,h)*0.55);
for(var y=-Math.max(w,h);y<Math.max(w,h)*1.5;y+=step){ctx.fillText(wm,0,y);}
ctx.restore();
};
image.onerror=function(){item.textContent='';};
image.src=src;
}
var wmObserver=new IntersectionObserver(function(entries){
entries.forEach(function(entry){
if(entry.isIntersecting){
var isYch=entry.target.classList.contains('ychph');
loadToCanvas(entry.target, isYch?'@melunyann':'@melune');
wmObserver.unobserve(entry.target);
}
});
},{rootMargin:'80px'});
document.querySelectorAll('.witem[data-src], .ychph[data-src]').forEach(function(el){
el.addEventListener('contextmenu',function(e){e.preventDefault();});
el.addEventListener('dragstart',function(e){e.preventDefault();});
wmObserver.observe(el);
});

function alignArrows(){
document.querySelectorAll('.scrollwrap').forEach(function(w){
var ph=w.querySelector('.ychph');if(!ph)return;
var top=(ph.offsetHeight-26)/2;
w.querySelectorAll('.arrow').forEach(function(b){b.style.top=top+'px';});
});
}
function updateArrowVisibility(w){
var row=w.querySelector('.ychrow'),btns=w.querySelectorAll('.arrow');
if(!row||btns.length<2)return;
btns[0].classList.toggle('hidden',row.scrollLeft<=4);
btns[1].classList.toggle('hidden',row.scrollLeft+row.clientWidth>=row.scrollWidth-4);
}
document.querySelectorAll('.scrollwrap').forEach(function(w){
var btns=w.querySelectorAll('.arrow'),row=w.querySelector('.ychrow');
btns[0].addEventListener('click',function(){row.scrollBy({left:-Math.round(row.clientWidth*0.7),behavior:'smooth'});});
btns[1].addEventListener('click',function(){row.scrollBy({left:Math.round(row.clientWidth*0.7),behavior:'smooth'});});
row.addEventListener('scroll',function(){updateArrowVisibility(w);},{passive:true});
updateArrowVisibility(w);
});
window.addEventListener('resize',function(){alignArrows();document.querySelectorAll('.scrollwrap').forEach(updateArrowVisibility);});
alignArrows();

document.querySelectorAll('.witem canvas, .ychph canvas').forEach(function(c){
c.addEventListener('touchstart',function(e){if(e.touches.length===1){c._tx=e.touches[0].clientX;c._ty=e.touches[0].clientY;}},{passive:true});
c.addEventListener('touchend',function(e){
var dx=Math.abs(e.changedTouches[0].clientX-(c._tx||0)),dy=Math.abs(e.changedTouches[0].clientY-(c._ty||0));
if(dx<5&&dy<5)e.preventDefault();
},{passive:false});
});
})();
</script>
