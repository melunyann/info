<style>
:root{
--pink:#FF5C7A;
--pink-deep:#E8425F;
--blue:#A9DDEE;
--blue-deep:#7FC7DE;
--bg:#FFF6F8;
--white:#FFFFFF;
--ink:#3F3A42;
--muted:#8B8790;
--border:#F5DCE1;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'Zen Maru Gothic',sans-serif;color:var(--ink);background:var(--bg)}
section{padding:64px 44px;border-top:1px solid var(--border)}
#home{border-top:none}
h1{font-size:22px;font-weight:700;margin:0 0 26px;letter-spacing:.02em}
.kicker{font-size:11px;letter-spacing:.18em;color:var(--pink-deep);margin-bottom:8px;font-weight:700}

/* ---- nav ---- */
.nav-wrap{position:fixed;top:16px;right:16px;z-index:999}
.nav-btn{width:50px;height:50px;border-radius:50%;background:var(--white);border:1.5px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;box-shadow:0 2px 10px rgba(63,58,66,0.10)}
.nav-bar{width:20px;height:2px;background:var(--pink);border-radius:2px;transition:transform .25s,opacity .2s}
.nav-wrap.open .nav-bar:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-wrap.open .nav-bar:nth-child(2){opacity:0}
.nav-wrap.open .nav-bar:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.nav-overlay{position:fixed;inset:0;background:rgba(63,58,66,.28);opacity:0;pointer-events:none;transition:opacity .25s;z-index:997}
.nav-overlay.show{opacity:1;pointer-events:auto}
.nav-panel{position:fixed;top:0;right:0;height:100%;width:min(300px,84vw);background:var(--white);z-index:998;transform:translateX(100%);transition:transform .3s cubic-bezier(.32,.72,0,1);padding:86px 28px 32px;display:flex;flex-direction:column;box-shadow:-6px 0 24px rgba(63,58,66,.10)}
.nav-panel.show{transform:translateX(0)}
.nav-panel .kicker{margin-bottom:20px}
.nav-item{display:flex;align-items:center;gap:12px;padding:14px 2px;text-decoration:none;color:var(--ink);border-bottom:1px solid #F7E8EB;font-weight:500;font-size:15px}
.nav-item:first-child{padding-top:0}
.nav-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.nav-item:nth-child(odd) .nav-dot{background:var(--pink)}
.nav-item:nth-child(even) .nav-dot{background:var(--blue-deep)}
.nav-foot{margin-top:auto;padding-top:20px;font-size:11px;color:var(--muted)}

/* ---- home ---- */
#home{padding-top:96px}
.home-title{font-size:28px;font-weight:700;line-height:1.6;margin:0 0 16px}
.home-title span{color:var(--pink)}
.home-sub{font-size:13.5px;color:var(--muted);line-height:2;max-width:32em;margin:0 0 22px}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;background:var(--pink);color:#fff;border-radius:20px;padding:6px 16px;margin-bottom:22px}
.btn{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;text-decoration:none;padding:13px 28px;border-radius:26px;background:var(--pink);color:#fff}
.btn:active{transform:scale(.97)}

/* ---- profile ---- */
.profile-row{display:flex;align-items:center;gap:16px;margin-bottom:20px}
.avatar{width:68px;height:68px;border-radius:50%;overflow:hidden;border:2px solid var(--blue);flex-shrink:0;background:var(--white)}
.avatar img{width:100%;height:100%;object-fit:cover;display:block;-webkit-user-drag:none;pointer-events:none}
.profile-name{font-size:16px;font-weight:700}
.stat-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.stat{font-size:11.5px;font-weight:500;border-radius:20px;padding:6px 14px;background:var(--white);border:1px solid var(--border);color:var(--muted)}
.stat.on{background:var(--blue);border-color:var(--blue-deep);color:#245a6b}
.bio{font-size:13.5px;line-height:2.3;color:var(--ink);background:var(--white);padding:22px 24px;border-radius:14px;border:1px solid var(--border)}
.more-link{display:inline-flex;align-items:center;gap:4px;margin-top:18px;font-size:12.5px;font-weight:700;color:var(--pink-deep);text-decoration:none}

/* ---- commission (price + ych) ---- */
.h2{font-size:15px;font-weight:700;margin:30px 0 14px}
.h2:first-of-type{margin-top:0}
.note{font-size:12px;color:var(--muted);margin:-6px 0 14px}
.tbl{background:var(--white);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.trow{display:flex;align-items:baseline;gap:2.4em;padding:20px 22px;font-size:13.5px;border-bottom:1px solid #F7E8EB}
.trow:last-child{border-bottom:none}
.trow b{color:var(--pink-deep)}
.optgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.optcard{background:var(--white);border:1px solid var(--border);border-radius:14px;padding:18px 18px;display:flex;flex-direction:column;gap:8px}
.optname{font-size:13px;font-weight:700}
.optprice{font-size:13px;color:var(--pink-deep);font-weight:500}
.optdesc{font-size:11px;color:var(--muted);line-height:1.9}
.ordergrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.ordercard{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--white)}
.orderimg{aspect-ratio:1;background:#FBEAEE;position:relative;overflow:hidden}
.orderimg img{width:100%;height:100%;object-fit:cover;display:block;-webkit-user-drag:none;user-select:none}
.orderbody{padding:16px 16px 18px;display:flex;flex-direction:column;gap:8px}
.orderdesc{font-size:10.5px;color:var(--muted);line-height:1.9}

.subdiv{margin-top:44px;padding-top:36px;border-top:2px dashed var(--blue)}
.commission-note{font-size:12px;color:#245a6b;background:#EAF7FB;padding:18px 22px;border-radius:14px;line-height:2}
.numbered{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;font-weight:700;margin:26px 0 14px}
.hno{font-size:11px;color:#fff;background:var(--blue-deep);width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.linkrow{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.linkbtn{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--blue-deep);background:#fff;border:1.5px solid var(--blue-deep);border-radius:18px;padding:7px 16px;text-decoration:none}
.linkbtn svg{width:13px;height:13px}
.scrollwrap{position:relative}
.arrow{position:absolute;top:0;z-index:2;width:20px;height:26px;border:none;background:none;color:rgba(255,92,122,0.5);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:17px}
.arrow.hidden{opacity:0;pointer-events:none}
.arrow:first-child{left:0}
.arrow:last-child{right:0}
.ychrow{display:flex;gap:12px;overflow-x:auto;padding-bottom:12px;scroll-behavior:smooth;-webkit-overflow-scrolling:touch}
.ychrow::-webkit-scrollbar{height:4px}
.ychrow::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}
.ychcard{flex:0 0 150px}
.ychph{aspect-ratio:1;background:#FBEAEE;border-radius:12px;position:relative;overflow:hidden;margin-bottom:6px}
.ychph canvas{width:100%;height:100%;display:block;position:absolute;top:0;left:0}
.ychcap{font-size:11px;color:var(--muted);text-align:center;line-height:1.8}

/* ---- works ---- */
.works-sub{font-size:12.5px;color:var(--muted);margin:0 0 24px}
.wgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.witem{aspect-ratio:1;background:#FBEAEE;border-radius:14px;position:relative;overflow:hidden}
.witem canvas{width:100%;height:100%;display:block;position:absolute;top:0;left:0}

/* ---- notice ---- */
.ncard{background:var(--white);border:1px solid var(--border);border-radius:14px;padding:20px 22px;margin-bottom:12px}
.nh2{font-size:14px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:8px}
.ndot{width:7px;height:7px;border-radius:50%;background:var(--pink);flex-shrink:0}
.nbody{font-size:12px;color:var(--muted);line-height:1.9}
.nnote{background:#EAF7FB;border-radius:14px;padding:18px 22px;font-size:12px;color:#245a6b;line-height:1.9;margin-top:20px}

/* ---- contact ---- */
.contact-sub{font-size:12.5px;color:var(--muted);margin:0 0 26px;line-height:2}
.clist{display:flex;flex-direction:column;gap:10px}
.citem{display:flex;align-items:center;gap:14px;background:var(--white);border:1px solid var(--border);border-radius:14px;padding:16px 20px;text-decoration:none;color:var(--ink)}
.cicon{width:38px;height:38px;border-radius:50%;background:#FBEAEE;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cicon svg{width:16px;height:16px;stroke:var(--pink);stroke-width:1.8;fill:none}
.cname{font-size:13.5px;font-weight:700}
.cdesc{font-size:10.5px;color:var(--muted);margin-top:2px}
.carrow{color:var(--blue-deep);font-size:14px;margin-left:auto}

@media (max-width:600px){
section{padding:52px 22px}
#home{padding-top:88px}
.optgrid,.ordergrid,.wgrid{grid-template-columns:1fr;gap:10px}
.ordercard{display:flex;flex-direction:row}
.orderimg{width:40%;flex:0 0 40%;aspect-ratio:unset}
.orderbody{flex:1;padding:14px 16px}
.wgrid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
